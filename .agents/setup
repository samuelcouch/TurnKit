#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
database_was_running=false
if command -v pg_isready >/dev/null && pg_isready -q; then
  database_was_running=true
fi
archive=''
cleanup() {
  [[ -z "$archive" ]] || rm -f "$archive"
  if ! $database_was_running && command -v pg_isready >/dev/null && pg_isready -q; then
    sudo pg_ctlcluster 15 main stop
  fi
}
trap cleanup EXIT

echo "[turnkit] Checking system dependencies"
packages=(build-essential ca-certificates curl libssl3 libyaml-0-2 libreadline8 libffi8 libgmp10 zlib1g libpq-dev postgresql-15)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

# ruby-builder's Ubuntu 22.04 binary also runs on Debian 12 (glibc/OpenSSL 3).
# Its embedded paths require this exact prefix. Avoid compiling Ruby on each orb.
ruby_root=/opt/hostedtoolcache/Ruby/3.3.10
if [[ ! -x "$ruby_root/x64/bin/ruby" ]]; then
  [[ $(uname -m) == x86_64 ]] || { echo "This setup requires an x64 orb" >&2; exit 1; }
  archive=$(mktemp)
  curl -fsSL --retry 3 https://github.com/ruby/ruby-builder/releases/download/ruby-3.3.10/ruby-3.3.10-ubuntu-22.04-x64.tar.gz -o "$archive"
  echo "aa6c8bdaca989be11f68fba5144f680c501b9286c46b6bfc8bfe5b690c36c724  $archive" | sha256sum --check --status
  sudo mkdir -p "$ruby_root"
  sudo tar xzf "$archive" -C "$ruby_root"
  rm -f "$archive"
  archive=''
fi
export PATH="$ruby_root/x64/bin:$PATH"
export BUNDLE_PATH="$HOME/.cache/turnkit/bundle"
ruby -ropenssl -ryaml -rzlib -rreadline -e 'puts "[turnkit] Ruby #{RUBY_VERSION} ready"'

# Amp and managed services start independent login shells; setup exports alone
# do not reach them. Keep the hook scoped to this checkout and its descendants.
marker='# TurnKit orb environment'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
  "$PWD/"*)
    export PATH="$ruby_root/x64/bin:\$PATH"
    export LANG=C.UTF-8
    export BUNDLE_PATH="\$HOME/.cache/turnkit/bundle"
    export TURNKIT_TEST_DATABASE_URL="\${TURNKIT_TEST_DATABASE_URL:-postgresql:///turnkit_test}"
    ;;
esac
EOF
fi

echo "[turnkit] Installing gems (${SECONDS}s)"
bundle config set --local path "$BUNDLE_PATH"
bundle install --jobs 4 --retry 3

echo "[turnkit] Preparing local test database (${SECONDS}s)"
# Setup may use a temporary database process, but must not leave one running.
# The declared Amp service owns the long-lived process after activation.
if ! pg_isready -q; then
  sudo pg_ctlcluster 15 main start
fi
if [[ $(sudo -u postgres psql -Atqc "SELECT 1 FROM pg_roles WHERE rolname = 'user'") != 1 ]]; then
  sudo -u postgres createuser user
fi
if [[ $(sudo -u postgres psql -Atqc "SELECT 1 FROM pg_database WHERE datname = 'turnkit_test'") != 1 ]]; then
  sudo -u postgres createdb -O user turnkit_test
fi
echo "[turnkit] Ready in ${SECONDS}s"
